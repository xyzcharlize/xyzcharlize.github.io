{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xyzcharlize.github.io/spine.schema.json",
  "title": "Portfolio spine",
  "type": "object",
  "required": ["version", "person", "box", "spine", "metaphor", "pillars", "surfaces"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "person": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "where": { "type": "string" }
      }
    },
    "box": {
      "type": "object",
      "required": ["label", "for", "sentence"],
      "properties": {
        "label": { "type": "string", "description": "The short label people can put you in." },
        "for": { "type": "string" },
        "sentence": { "type": "string" }
      }
    },
    "spine": {
      "type": "object",
      "required": ["thread", "mantra", "oneLiner", "support", "why"],
      "properties": {
        "thread": { "type": "string", "description": "The red thread — three beats max." },
        "mantra": { "type": "string" },
        "oneLiner": { "type": "string" },
        "support": { "type": "string" },
        "why": { "type": "string" }
      }
    },
    "metaphor": {
      "type": "object",
      "required": ["visual", "verbal"],
      "properties": {
        "visual": { "type": "string" },
        "visualModule": { "type": "string" },
        "verbal": { "type": "string" },
        "verbalModule": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "pillars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "text"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "text": { "type": "string" },
          "samples": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["text", "href"],
                  "properties": {
                    "text": { "type": "string" },
                    "href": {
                      "type": "string",
                      "description": "Site-relative path under the Astro base (e.g. speaking/)"
                    }
                  }
                }
              ]
            },
            "description": "Short work samples for this phase (no employer or client names)"
          },
          "glossary": {
            "type": "array",
            "items": { "type": "string" },
            "description": "glossary.json term ids that load this pillar"
          }
        }
      }
    },
    "glossary": {
      "type": "object",
      "required": ["path", "onSpine"],
      "properties": {
        "path": { "type": "string" },
        "note": { "type": "string" },
        "onSpine": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "role"],
            "properties": {
              "id": { "type": "string" },
              "pillar": { "type": "string" },
              "role": { "type": "string" }
            }
          }
        }
      }
    },
    "useCases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "cases"],
        "properties": {
          "category": { "type": "string" },
          "cases": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": ["name", "tags", "problem", "solution"],
              "properties": {
                "name": { "type": "string" },
                "tags": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "enum": ["Strategy", "Governance", "Metrics", "Infrastructure", "Delivery", "Enablement", "Culture"]
                  }
                },
                "problem": { "type": "string" },
                "solution": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "workedWith": {
      "type": "object",
      "required": ["label", "logos"],
      "properties": {
        "label": { "type": "string" },
        "note": { "type": "string" },
        "logos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "file": { "type": "string" },
              "credit": { "type": "string" },
              "licence": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        }
      }
    },
    "surfaces": { "type": "object", "additionalProperties": { "type": "string" } },
    "constraints": {
      "type": "object",
      "properties": {
        "public": { "type": "array", "items": { "type": "string" } }
      }
    },
    "practice": { "type": "array", "items": { "type": "string" } },
    "site": { "type": "object" }
  }
}
