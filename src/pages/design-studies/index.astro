---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { spine } from '../../lib/spine';
import '../../styles/design-studies.css';

const base = import.meta.env.BASE_URL;

const studies = [
  {
    href: `${base}design-studies/letter/`,
    name: 'Letter',
    text: 'The sentence leads. The name stays in the letterhead, and the portrait sits beside the opening at the size of a photograph on a desk.',
  },
  {
    href: `${base}design-studies/diptych/`,
    name: 'Diptych',
    text: 'The name and the portrait share the opening. A golden cut divides them, and the photograph is the smaller half, mounted on a warm mat.',
  },
  {
    href: `${base}design-studies/byline/`,
    name: 'Byline',
    text: 'The work leads. The portrait is a small signature in the masthead, beside the name, and the practice is indexed in a side column.',
  },
  {
    href: base,
    name: 'Current home',
    text: 'The portrait fills the first screen. The name and the one-liner are set over it.',
  },
];
---

<BaseLayout
  title={`Home page studies — ${spine.person.name}`}
  description="Three still alternatives for the home page, each keeping the portrait at a smaller scale."
  robots="noindex, nofollow"
>
  <div class="studies-root">
    <SiteHeader solid />

    <main id="main" class="page">
      <header class="page-hero shell study-index-hero">
        <p class="eyebrow">Home page</p>
        <h1>Three other ways to open.</h1>
        <p class="page-lede">
          The home page opens on a full-screen portrait. These studies keep the same words, the same photograph, and the same work. The portrait sits at a smaller scale. The studies stay still.
        </p>
      </header>

      <div class="shell">
        <ol class="study-index">
          {
            studies.map((study) => (
              <li>
                <a href={study.href}>
                  <span class="study-index-name">{study.name}</span>
                  <span class="study-index-text">{study.text}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </main>

    <SiteFooter plain />
  </div>
</BaseLayout>
