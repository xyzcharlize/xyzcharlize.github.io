---
import { workedWith } from '../lib/spine';

const base = import.meta.env.BASE_URL;
---

<section class="study-block shell study-logos" id="worked-with" aria-labelledby="worked-with-heading">
  <h2 id="worked-with-heading">{workedWith.label}</h2>
  {workedWith.note && <p class="study-dek">{workedWith.note}</p>}
  <ul class="logo-grid">
    {
      workedWith.logos.map((logo) => (
        <li class="logo-tile" title={logo.name}>
          {logo.file ? (
            <img src={`${base}${logo.file}`} alt={logo.name} loading="lazy" decoding="async" />
          ) : (
            <span class="logo-word">{logo.name}</span>
          )}
        </li>
      ))
    }
  </ul>
</section>
