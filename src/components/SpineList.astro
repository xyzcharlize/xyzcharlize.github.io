---
import { pillars, sampleHref, sampleText } from '../lib/spine';

interface Props {
  variant?: 'letter' | 'bands';
}

const { variant = 'bands' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ol class:list={['spine-index', `spine-index--${variant}`]}>
  {
    pillars.map((pillar, index) => (
      <li id={pillar.id}>
        <span class="spine-no" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <h3>{pillar.label}</h3>
        <div class="spine-body">
          <p>{pillar.text}</p>
          {pillar.samples?.length ? (
            <ul>
              {pillar.samples.map((sample) => {
                const text = sampleText(sample);
                const href = sampleHref(sample);
                return <li>{href ? <a href={`${base}${href}`}>{text}</a> : text}</li>;
              })}
            </ul>
          ) : null}
        </div>
      </li>
    ))
  }
</ol>
